# Django runtime configuration. Keep the real .env file out of version control.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon pooled PostgreSQL URL for Django application traffic.
# Pull this from a linked Neon project; never paste it into frontend variables.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_POOLER_HOST/DBNAME?sslmode=require
# Neon direct URL for migrations, schema operations, and database dumps.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DBNAME?sslmode=require

# Neon Auth URLs are injected by `neon env pull`; OpenAI remains backend-only.
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_HOST/DBNAME/auth
NEON_AUTH_JWKS_URL=https://YOUR_NEON_AUTH_HOST/DBNAME/auth/.well-known/jwks.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
