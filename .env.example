# Django runtime configuration. Keep the real .env file out of version control.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL direct connection string. Use the development project.
# Obtain this from Supabase Dashboard -> Connect; do not use an Auth API key here.
# Copy the URL from Supabase Dashboard -> Connect. Password characters must be URL-encoded.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Backend-only integration settings for later phases. Never expose OPENAI_API_KEY
# or a Supabase service-role key to Vite/React.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-PUBLISHABLE-KEY]
SUPABASE_JWT_ISSUER=https://[YOUR-PROJECT-REF].supabase.co/auth/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
